# Copy to .env and fill in. Never commit .env.

# Anthropic - router, planner, safety classifier, relevance grader
ANTHROPIC_API_KEY=

# Voyage AI - embeddings for the vector store (voyage-3.5)
VOYAGE_API_KEY=

# Pinecone - vector store (index: cbt-mental-health)
PINECONE_API_KEY=

# Neo4j - knowledge graph (Aura or self-hosted; APOC required)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Postgres - LangGraph conversation checkpointer (e.g. Neon)
DATABASE_URL=

# Tavily - live web search fallback
TAVILY_API_KEY=

# LangSmith tracing (optional). Reuse an existing workspace key - the PROJECT
# name is what separates this app's traces. By default full message + answer
# text is captured; set LANGSMITH_HIDE_INPUTS / LANGSMITH_HIDE_OUTPUTS to
# "true" if you ever need to keep that content out of the traces.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=mental-health-chatbot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com   # EU: https://eu.api.smith.langchain.com

# Backend only, optional: comma-separated frontend origins for CORS
# (default: http://localhost:8501)
ALLOWED_ORIGINS=

# --- Cost & rate controls (all optional, sensible defaults) ---
# ANTHROPIC_RPS     client-side request/sec cap shared by every Claude call (default 2)
# CHAT_RATE_LIMIT   per-client cap on POST /chat, slowapi syntax (default "20/minute")
# DAILY_BUDGET_USD  backend refuses /chat with 503 once a UTC day's spend passes this (default 5)
# LLM_CACHE         set to 0 to disable the exact-match response cache (Postgres when
#                   DATABASE_URL is set, in-process otherwise)
# ANTHROPIC_RPS=2
# CHAT_RATE_LIMIT=20/minute
# DAILY_BUDGET_USD=5
# LLM_CACHE=1

# Optional model overrides.
# FAST_MODEL  - routing, grading, planning, condensing, safety classifier
# SMART_MODEL - answer synthesis (production)
# JUDGE_MODEL      - offline LLM-as-judge (faithfulness, correctness) - eval only
# JUDGE_FAST_MODEL - cheaper judge for the per-chunk Ragas context metrics - eval only
# FAST_MODEL=claude-haiku-4-5
# SMART_MODEL=claude-sonnet-5
# JUDGE_MODEL=claude-opus-5
# JUDGE_FAST_MODEL=claude-sonnet-5

# Evaluation cost guard (evaluate.py / ragas_eval.py). Run aborts with a
# partial report once judge spend passes this. JUDGE_THINKING=1 re-enables
# Opus thinking on the judge (more expensive, slower). The response cache above
# applies to eval too - re-runs on unchanged items are near-free.
# EVAL_MAX_USD=5
# JUDGE_THINKING=0
