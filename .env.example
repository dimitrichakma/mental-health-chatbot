# Copy to .env and fill in. Never commit .env.

# Anthropic - router, planner, safety classifier, relevance grader
ANTHROPIC_API_KEY=

# Voyage AI - embeddings for the vector store (voyage-3.5)
VOYAGE_API_KEY=

# Pinecone - vector store (index: cbt-mental-health)
PINECONE_API_KEY=

# Neo4j - knowledge graph (Aura or self-hosted; APOC required)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Postgres - LangGraph conversation checkpointer (e.g. Neon)
DATABASE_URL=

# Tavily - live web search fallback
TAVILY_API_KEY=

# Backend only, optional: comma-separated frontend origins for CORS
# (default: http://localhost:8501)
ALLOWED_ORIGINS=

# Optional model overrides.
# FAST_MODEL  - routing, grading, planning, condensing, safety classifier
# SMART_MODEL - answer synthesis (production)
# JUDGE_MODEL      - offline LLM-as-judge (faithfulness, correctness) - eval only
# JUDGE_FAST_MODEL - cheaper judge for the per-chunk Ragas context metrics - eval only
# FAST_MODEL=claude-haiku-4-5
# SMART_MODEL=claude-sonnet-5
# JUDGE_MODEL=claude-opus-5
# JUDGE_FAST_MODEL=claude-sonnet-5

# Evaluation cost guard (evaluate.py / ragas_eval.py). Run aborts with a
# partial report once judge spend passes this. JUDGE_THINKING=1 re-enables
# Opus thinking on the judge (more expensive, slower).
# EVAL_MAX_USD=5
# JUDGE_THINKING=0
