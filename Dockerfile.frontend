# Next.js frontend - deliberately standalone (its own package.json/lockfile,
# no dependency on the backend's Python code), same "frontend deploys on its
# own" boundary the old Streamlit app had.

FROM node:22-slim AS build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend .

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, not
# read at runtime - Railway passes a service's variables as Docker build
# args automatically, so this picks up the BACKEND_URL already set on the
# frontend service. Falls back to the deployed backend if unset.
ARG BACKEND_URL=https://backend-production-63da.up.railway.app
ENV NEXT_PUBLIC_BACKEND_URL=$BACKEND_URL
RUN npm run build

FROM node:22-slim AS run
WORKDIR /app
ENV NODE_ENV=production

# `output: "standalone"` (next.config.ts) traces only the files server.js
# needs, so the runtime image doesn't carry node_modules or the Next CLI.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

EXPOSE 8501
CMD ["sh", "-c", "PORT=${PORT:-8501} HOSTNAME=0.0.0.0 node server.js"]
