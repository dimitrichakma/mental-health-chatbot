# Copy to .env.local (gitignored) for `npm run dev`.

# Backend the browser talks to directly.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Auth.js session cookie signing - generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (console.cloud.google.com -> APIs & Services ->
# Credentials). Add http://localhost:3000/api/auth/callback/google as an
# authorized redirect URI.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared with the backend's own env - must match exactly, generate with:
# openssl rand -hex 32
BACKEND_JWT_SECRET=
